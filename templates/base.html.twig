<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Brasil Burger Admin{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2290%22>🍔</text></svg>">
        
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

        <style>
            body { font-family: 'Inter', sans-serif; }
            .active-link { background-color: #facc15; color: #0f172a; border-radius: 9999px 0 0 9999px; }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-[#f8f9fa]">
        <div class="flex min-h-screen">
            
            <aside class="w-64 bg-[#0f172a] text-white flex-shrink-0">
                <div class="p-6">
                    <div class="flex items-center gap-3">
                        <div class="bg-yellow-500 p-2 rounded-lg">
                            <i class="fas fa-hamburger text-slate-900 text-xl"></i>
                        </div>
                        <div>
                            <h1 class="text-lg font-bold leading-tight">Brasil Burger</h1>
                            <p class="text-[10px] text-gray-400 uppercase tracking-widest">Back Office</p>
                        </div>
                    </div>
                </div>

                <nav class="mt-4 pl-4">
                {% set route = app.request.attributes.get('_route') %}
                    <ul class="space-y-1">
                        <li>
                            
                            <a href="{{ path('admin_dashboard') }}" 
                                    class="flex items-center gap-3 px-4 py-3 text-sm font-medium {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active-link' : 'text-gray-400 hover:text-white hover:bg-slate-800 rounded-l-full' }}">
                                <i class="fas fa-th-large w-5"></i> Dashboard
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('admin_burger_index') }}" 
                            class="flex items-center gap-3 px-4 py-3 text-sm font-medium {{ app.request.attributes.get('_route') == 'admin_burger_index' ? 'active-link' : 'text-gray-400 hover:text-white hover:bg-slate-800 rounded-l-full' }}">
                                <i class="fas fa-hamburger w-5"></i> Burgers
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('admin_menu_index') }}" 
                            class="flex items-center gap-3 px-4 py-3 text-sm font-medium {{ app.request.attributes.get('_route') == 'admin_menu_index' ? 'active-link' : 'text-gray-400 hover:text-white hover:bg-slate-800 rounded-l-full' }}">
                                <i class="fas fa-utensils w-5"></i> Menus
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('admin_complement_index') }}" 
                            class="flex items-center gap-3 px-4 py-3 text-sm font-medium {{ app.request.attributes.get('_route') == 'admin_complement_index' ? 'active-link' : 'text-gray-400 hover:text-white hover:bg-slate-800 rounded-l-full' }}">
                                <i class="fas fa-ice-cream w-5"></i> Compléments
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('admin_commande_index') }}" 
                            class="flex items-center gap-3 px-4 py-3 text-sm font-medium {{ app.request.attributes.get('_route') == 'admin_commande_index' ? 'active-link' : 'text-gray-400 hover:text-white hover:bg-slate-800 rounded-l-full' }}">
                                <i class="fas fa-clipboard-list w-5"></i> Commandes
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('admin_zone_index') }}" 
                            class="flex items-center gap-3 px-4 py-3 text-sm font-medium {{ app.request.attributes.get('_route') == 'admin_zone_index' ? 'active-link' : 'text-gray-400 hover:text-white hover:bg-slate-800 rounded-l-full' }}">
                                <i class="fas fa-map-marker-alt w-5"></i> Zones & Livreurs
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('admin_paiement_index') }}" 
                            class="flex items-center gap-3 px-4 py-3 text-sm font-medium {{ app.request.attributes.get('_route') == 'admin_paiement_index' ? 'active-link' : 'text-gray-400 hover:text-white hover:bg-slate-800 rounded-l-full' }}">
                                <i class="fas fa-credit-card w-5"></i> Paiements
                            </a>
                        </li>
                    </ul>
                </nav>
            </aside>

            <div class="flex-1 flex flex-col">
                
                {# templates/base.html.twig #}
                <header class="h-16 bg-white border-b border-gray-100 flex items-center justify-between px-8">
                    <div class="flex items-center">
                        <h2 class="text-sm font-semibold text-gray-700">Panneau d'administration</h2>
                        <span class="mx-3 text-gray-300">|</span>
                        <p class="text-xs text-gray-400">Gérez votre restaurant Brasil Burger</p>
                    </div>

                    <div class="flex items-center gap-6">
                        <div class="relative cursor-pointer">
                            <i class="far fa-bell text-gray-400 text-lg"></i>
                            <span class="absolute -top-1 -right-1 bg-red-500 w-2 h-2 rounded-full border-2 border-white"></span>
                        </div>
                        
                        <div class="flex items-center gap-3 border-l pl-6">
                            <span class="text-xs font-medium text-gray-500">Admin</span>
                            {# Bouton Déconnexion #}
                            <a href="{{ path('app_logout') }}" class="flex items-center gap-2 text-[11px] font-bold bg-red-50 px-4 py-2 rounded-lg text-red-600 hover:bg-red-600 hover:text-white transition-all uppercase tracking-wider">
                                <i class="fas fa-sign-out-alt"></i>
                                Déconnexion
                            </a>
                        </div>
                    </div>
                </header>

                <main class="p-8 overflow-y-auto">
                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>

        {% block javascripts %}{% endblock %}
    </body>
</html>