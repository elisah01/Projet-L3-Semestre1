{# templates/security/login.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Connexion - Brasil Burger</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#0f172a] flex flex-col items-center justify-center min-h-screen font-sans">

    <div class="bg-white p-10 rounded-3xl shadow-2xl w-full max-w-md">
        <div class="flex justify-center mb-6">
            <div class="bg-black p-4 rounded-lg">
                 <i class="fas fa-hamburger text-yellow-500 text-3xl"></i>
            </div>
        </div>

        <h1 class="text-2xl font-bold text-center text-slate-900 mb-2">Espace Gestionnaire</h1>
        <p class="text-gray-500 text-center text-sm mb-8">Connectez-vous à votre panneau d'administration</p>

        <form method="post">
            {% if error %}
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm">
                    Identifiants invalides.
                </div>
            {% endif %}

            <div class="mb-5">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Email</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                        <i class="far fa-envelope"></i>
                    </span>
                    <input type="email"value="{{ last_username }}" name="_username" id="inputEmail" required autofocus                          
                           class="block w-full pl-10 pr-3 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm" 
                           placeholder="admin@brasilburger.com" required autofocus>
                </div>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Mot de passe</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                        <i class="fas fa-lock"></i>
                    </span>
                    <input type="password" name="_password" id="inputPassword" required
                           class="block w-full pl-10 pr-3 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm" 
                           placeholder="********" required>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="w-full bg-[#ff3b3b] hover:bg-red-700 text-white font-bold py-3 px-4 rounded-xl transition-colors shadow-lg shadow-red-200 mb-6">
                Se connecter
            </button>

            <div class="text-center">
                <a href="#" class="text-sm font-medium text-red-500 hover:text-red-700 transition">Mot de passe oublié ?</a>
            </div>
        </form>
    </div>

    <footer class="mt-8 text-gray-500 text-[11px] uppercase tracking-widest">
        &copy; 2024 Brasil Burger. Tous droits réservés.
    </footer>

</body>
</html>