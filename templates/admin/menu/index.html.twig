{% extends 'base.html.twig' %}

{% block body %}
<div class="p-8 bg-[#f8f9fa] min-h-screen">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Gestion des Menus</h1>
            <p class="text-gray-500 text-sm">Gérez vos menus et leurs compositions</p>
        </div>
    </div>

    <div class="mb-8">
        <div class="relative max-w-2xl">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" placeholder="Rechercher un menu..." class="w-full pl-12 pr-4 py-4 bg-white border-none rounded-2xl shadow-sm focus:ring-2 focus:ring-yellow-400">
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {% for menu in [
            {'nom': 'Menu Classic', 'desc': 'Burger + Frites + Boisson', 'prix': '7000'},
            {'nom': 'Menu Deluxe', 'desc': 'Burger Premium + Frites XL + Boisson + Dessert', 'prix': '9500'}
        ] %}
        <div class="bg-white rounded-[2.5rem] shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
            <div class="h-56 bg-gray-200 relative">
                <img src="https://images.unsplash.com/photo-1594212699903-ec8a3eca50f5?auto=format&fit=crop&w=500" class="w-full h-full object-cover">
            </div>
            <div class="p-8">
                <h3 class="text-xl font-bold text-gray-800 mb-2">{{ menu.nom }}</h3>
                <p class="text-gray-400 text-sm mb-6">{{ menu.desc }}</p>
                <div class="flex justify-between items-center">
                    <span class="text-[#ff3b3b] font-bold text-lg">{{ menu.prix }} FCFA</span>
                    <div class="flex gap-2">
                        <button class="w-10 h-10 bg-blue-50 text-blue-500 rounded-xl flex items-center justify-center"><i class="far fa-edit"></i></button>
                        <button class="w-10 h-10 bg-red-50 text-red-500 rounded-xl flex items-center justify-center"><i class="far fa-trash-alt"></i></button>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}