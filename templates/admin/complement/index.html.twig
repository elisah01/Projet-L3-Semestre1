{% extends 'base.html.twig' %}

{% block body %}
<div class="p-8 bg-[#f8f9fa] min-h-screen">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Gestion des Compléments</h1>
            <p class="text-gray-500 text-sm">Gérez vos accompagnements et boissons</p>
        </div>
        <button class="bg-[#ff3b3b] text-white px-6 py-3 rounded-xl font-bold">+ Ajouter un complément</button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {% for i in 1..4 %}
        <div class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden">
            <img src="https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=300" class="w-full h-48 object-cover">
            <div class="p-6">
                <h3 class="font-bold text-gray-800">Frites</h3>
                <p class="text-gray-400 text-xs mb-4">Portion croustillante maison</p>
                <div class="text-[#ff3b3b] font-bold mb-4">1500 FCFA</div>
                <div class="flex gap-2">
                    <button class="flex-1 bg-blue-50 text-blue-500 py-2 rounded-xl text-xs font-bold">Modifier</button>
                    <button class="w-10 h-10 bg-red-50 text-red-500 rounded-xl flex items-center justify-center"><i class="far fa-trash-alt"></i></button>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}